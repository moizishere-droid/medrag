# OpenAI
AUTH_REQUIRED=true
AUTH_TOKEN_HOURS=24
# Set true when serving through HTTPS. Local HTTP development uses false.
AUTH_COOKIE_SECURE=false
# JSON array of browser frontend origins allowed to sign in with cookies.
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:8502","http://127.0.0.1:8502"]
# Optional frontend settings: API address for Streamlit and browser respectively.
MEDRAG_API_URL=http://127.0.0.1:8000
MEDRAG_BROWSER_API_URL=http://localhost:8000
# Load local retrieval models at startup to avoid a slow first question.
RETRIEVAL_WARMUP=true
RERANK_BACKEND=onnx
RERANK_THREADS=4
OPENAI_API_KEY=

# PubMed E-utilities
PUBMED_EMAIL=
NCBI_API_KEY=
OPENFDA_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medragpassword

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=medrag_chat
POSTGRES_USER=medrag
POSTGRES_PASSWORD=medragpassword

# Weights & Biases
WANDB_API_KEY=