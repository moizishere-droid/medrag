# Create these values in Modal Secret medrag-demo. Do not publish real values.
OPENAI_API_KEY=
PUBMED_EMAIL=
QDRANT_URL=
QDRANT_API_KEY=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=
POSTGRES_PASSWORD=
PGSSLMODE=require
# After first modal deploy, set the HTTPS URL printed by Modal (no /api suffix).
MEDRAG_PUBLIC_ORIGIN=

# Keep false until the explicit provision command passes.
MEDRAG_DEMO_READY=false
